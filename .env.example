# Copy this file to ".env" and add your own key to get fully
# generated answers from the OpenAI API (see Module 8).
# Without a key, the tool uses an offline extractive fallback:
# retrieval, threshold and citations work exactly the same.
OPENAI_API_KEY=your_openai_api_key_here

# Optional overrides:
# OPENAI_MODEL=gpt-4o-mini
# RAG_SIMILARITY_THRESHOLD=0.35
